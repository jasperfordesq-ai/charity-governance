{
	# Zero-downtime `caddy reload` (scripts/bluegreen-deploy.mjs's switch/
	# rollback paths) needs a live admin API to push the new config to —
	# `admin off` (the original T4 hardening) leaves no listener at all, so
	# every deploy's reload call fails and the cutover can never complete.
	# A unix socket on the container's own /tmp tmpfs keeps the admin API
	# reachable from inside the container (where reload runs, via `docker
	# compose exec`) while staying invisible to the compose network and the
	# host — no TCP port, nothing to publish, nothing else can reach it.
	admin unix//tmp/caddy-admin.sock
	auto_https off
	persist_config off

	# ── The default logger carries Caddy's ERROR log, and it is not filtered
	# by the site `log` directive below. ───────────────────────────────────
	#
	# A site-level `log` only creates and filters the ACCESS logger
	# (`http.log.access.log0`), and adapting this file shows Caddy excluding
	# exactly that one name from the default logger. Caddy's ERROR logger
	# (`http.log.error.log0`) is NOT excluded, so it falls through to the
	# default logger — no encoder, no filter, straight to stderr. `docker
	# logs` merges stdout and stderr, which is precisely the command
	# docs/bluegreen-runbook.md tells an operator to run.
	#
	# The error logger fires whenever a handler returns an error: upstream
	# unreachable, upstream timeout, client disconnect mid-proxy. That makes
	# the leak WORSE than the access-log one it sits beside — on a 502 the
	# authorization code was never delivered to the API, so it is unspent and
	# still live at Atlassian, and the `state` has its full ten minutes left.
	#
	# Filtering the default logger itself is what closes it. Reproduced and
	# verified against the pinned caddy:2-alpine@sha256:5f5c8640… (v2.11.4):
	# before, `SECRETCODE123` appeared twice on stderr; after, zero times on
	# either stream.
	#
	# Note the asymmetry with the application redactor, which the runbook's
	# "the same leak, one layer further out" does not imply parity for:
	# Caddy's `query` filter matches parameter names CASE-SENSITIVELY and
	# does not percent-decode them, while `apps/api/src/utils/logger.ts`
	# catches `CoDe` and `%63ode` as well. Atlassian only ever sends
	# lowercase `code` and `state`, so nothing here is exploitable — but the
	# two layers are not equivalent, and the proxy is the weaker of them.
	#
	# DO NOT delete this as a duplicate of the site `log` below; it covers a
	# different logger. Pinned by scripts/check-bluegreen-compose.test.mjs.
	log default {
		output stderr
		format filter {
			wrap json
			fields {
				request>uri query {
					delete code
					delete state
				}
			}
		}
	}
}

:8080 {
	encode zstd gzip
	header {
		-Server
		X-Robots-Tag "noindex, nofollow, noarchive"
	}

	import /etc/caddy/active-upstreams.caddy

	log {
		# Redact the OAuth callback's query parameters before they are written.
		#
		# THIS FILTER IS REQUIRED ON THE NORMAL CONNECT PATH. It is not
		# legacy defence, and it must not be removed.
		#
		# Caddy's JSON access log records `request.uri` INCLUDING the query
		# string. Phase 6 moved the callback from a route in apps/api to a
		# PAGE in apps/web. That changed what the application does with
		# `code`/`state` once it has them (it POSTs them in a JSON body
		# instead of putting them in an API request line) — it did NOT
		# change how they arrive. `confluenceRedirectUri()` registers
		#   {FRONTEND_URL}/integrations/confluence/callback
		# and ATLASSIAN, not this codebase, appends the query string to
		# whatever redirect URI is registered. This site block proxies the
		# web app and the API together, so on EVERY successful connection
		# this proxy sees
		#   GET /integrations/confluence/callback?code=...&state=...
		# and this filter is the only thing keeping it out of the log.
		#
		# That request is the page LOAD, before the page POSTs the code, so
		# the value in the log line would be a LIVE, UNSPENT authorization
		# code with the `state` still inside its full TTL — worse than the
		# retired-route case below, not better.
		#
		# The OLD, retired API address still answers rather than 404ing, so
		# a deployment whose Atlassian app is still registered against
		#   GET /api/v1/integrations/confluence/callback?code=...&state=...
		# leaks the same way there. This filter covers BOTH paths.
		# `apps/api/src/utils/logger.ts` censors both parameters out of the
		# API's own log one layer in; this is the log an operator is most
		# likely to `docker logs` and paste into a ticket.
		#
		# It deletes TOP-LEVEL `code`/`state` only — it cannot see either
		# value nested inside another parameter (e.g.
		# `/login?next=%2F...%3Fcode%3D...`), so application code that builds
		# such a URL must strip the secrets itself. `redirectToLogin` in
		# apps/web/src/proxy.ts does, and is pinned by a test.
		#
		# DO NOT remove this as noise. See docs/bluegreen-runbook.md.
		output stdout
		format filter {
			wrap json
			fields {
				request>uri query {
					delete code
					delete state
				}
			}
		}
	}
}
