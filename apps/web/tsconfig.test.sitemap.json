// Separate sitemap compilation is retained for the existing test runner.
// Environment-changing tests now also compile with Next's readonly NODE_ENV
// declaration, and the full web tsconfig is checked without excluding tests.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": false,
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": false,
    "outDir": "./.test-dist-sitemap",
    "rootDir": "./src",
    "sourceMap": false
  },
  "include": [
    "src/app/sitemap.ts",
    "src/app/sitemap.test.ts"
  ]
}
