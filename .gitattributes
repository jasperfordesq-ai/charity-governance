# The recovery proof authenticates this helper's exact committed bytes.
scripts/postgres-backup.mjs text eol=lf
fixtures/recovery-canary-v1.txt text eol=lf

# A NUL byte in a source file makes git classify the file as binary, and a
# binary file has no reviewable diff: `git diff` prints "Binary files differ"
# and every later change to it lands unseen. `npm run security:control-bytes`
# fails the build on such a byte, and these keep the diff readable in the
# meantime, so the corruption shows up as the one-line change it is rather
# than hiding the whole file.
*.ts diff
*.tsx diff
*.js diff
*.jsx diff
*.mjs diff
*.cjs diff
*.json diff
*.md diff
*.sql diff
*.prisma diff
*.yml diff
*.yaml diff
scripts/managed-proof-systemd-containment.mjs text eol=lf
scripts/managed-proof-channel*.mjs text eol=lf
scripts/managed-proof-guardian.mjs text eol=lf
