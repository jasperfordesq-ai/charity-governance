# =============================================================================
# CharityPilot — Environment Variables
# Copy to .env and fill in real values.
# Port assignments (avoids conflicts with other Nexus projects):
#   API → 3002  |  Web → 3003  |  PostgreSQL → 5434
# =============================================================================

# Database
DATABASE_URL=postgresql://charitypilot:charitypilot_dev@localhost:5434/charitypilot

# Server
PORT=3002
HOST=0.0.0.0
TRUSTED_PROXY_ADDRESSES=
READINESS_API_KEY=change-me-local-readiness-key-at-least-32-characters

# JWT
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
# Deterministic local-only root key. Generate an independent canonical 32-64 byte
# hex/base64url value for every non-local environment; never reuse JWT_SECRET.
AUTH_RECOVERY_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_EXPIRY=15m
REFRESH_TOKEN_TTL_DAYS=7

# Owner console
# Separate high-entropy secret for the platform-owner JWT. Must be at least 32
# characters and distinct from JWT_SECRET; the boot guard rejects equality.
OWNER_JWT_SECRET=change-me-to-a-different-random-string-at-least-32-chars
# Absolute origin the owner-console bootstrap CLI (npm run owner:create) uses to
# build the set-password link it emails. APP_ORIGIN is used as a fallback.
OWNER_CONSOLE_ORIGIN=http://localhost:3003

# Capability axes (optional — defaults derive from CHARITYPILOT_DEPLOYMENT_MODE).
# CHARITYPILOT_TENANCY=multi            # multi | single
# CHARITYPILOT_REGISTRATION=open        # open | closed
# CHARITYPILOT_EMAIL_DELIVERY=provider  # provider | manual-link
# CHARITYPILOT_BILLING=stripe           # stripe | none
# The NEXT_PUBLIC_ web axis vars below are BUILD-TIME vars for the web surface:
# Next.js bakes them into the client bundle at `docker build` (see the ARGs in
# apps/web/Dockerfile), so setting them only at container run time has no
# effect. The API vars above are read at runtime instead.
# NEXT_PUBLIC_CHARITYPILOT_TENANCY=
# NEXT_PUBLIC_CHARITYPILOT_REGISTRATION=
# NEXT_PUBLIC_CHARITYPILOT_EMAIL_DELIVERY=
# NEXT_PUBLIC_CHARITYPILOT_BILLING=

# Self-contained storage pairing (optional — already active below via the local
# driver for this dev template; production validation now accepts local storage
# in the same way whenever DOCUMENT_STORAGE_DRIVER says so, no Supabase required).
# DOCUMENT_STORAGE_DRIVER=local
# LOCAL_FILE_STORAGE_DIR=

# Frontend URL (for CORS, email links)
FRONTEND_URL=http://localhost:3003
API_URL=http://localhost:3002

# Canonical production origins (optional — for non-charitypilot.ie deployments, e.g. the private VM; default to the hosted origins).
# CHARITYPILOT_CANONICAL_WEB_ORIGIN=https://app.charitypilot.ie
# CHARITYPILOT_CANONICAL_API_ORIGIN=https://api.charitypilot.ie
# Private Hyper-V VM (blue-green, multi-tenant, self-contained): see .env.bluegreen.private-vm.example
# Set to none on a deployment with no alerting webhook to stop requiring ERROR_ALERT_WEBHOOK_URL in production; defaults to webhook.
# CHARITYPILOT_ERROR_ALERTS=webhook  # webhook | none

# Stripe
# Production hardening: checkout is disabled unless all Stripe values below are real.
# Create separate monthly/yearly prices for Essentials and Complete in Stripe.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_ESSENTIALS_MONTHLY_PRICE_ID=price_...
STRIPE_ESSENTIALS_YEARLY_PRICE_ID=price_...
STRIPE_COMPLETE_MONTHLY_PRICE_ID=price_...
STRIPE_COMPLETE_YEARLY_PRICE_ID=price_...
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=bpc_...

# Resend (email)
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@charitypilot.ie

# File storage (Supabase)
# Use local filesystem storage for laptop-only testing.
DOCUMENT_STORAGE_DRIVER=local
LOCAL_FILE_STORAGE_DIR=.charitypilot-local-storage/documents
STORAGE_DOWNLOAD_TIMEOUT_MS=10000

# Later production/provider testing can switch DOCUMENT_STORAGE_DRIVER back to Supabase by
# filling these provider values and setting DOCUMENT_STORAGE_DRIVER=supabase or leaving it unset.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_STORAGE_BUCKET=documents

# Next.js public vars
NEXT_PUBLIC_API_URL=http://localhost:3002

# Optional local demo seed. Leave disabled in production.
SEED_LOCAL_ADMIN=true
LOCAL_ADMIN_EMAIL=admin@charitypilot.local
LOCAL_ADMIN_PASSWORD=LocalAdmin123!
LOCAL_ADMIN_NAME=Local CharityPilot Admin
LOCAL_ADMIN_ORGANISATION=My Local Charity

# Legacy demo seed support. Leave disabled unless you specifically need the old demo account.
SEED_DEMO_WORKSPACE=false
DEMO_PASSWORD=
