{
  "name": "charitypilot-mcp",
  "version": "0.1.0",
  "description": "The CharityPilot connector: a Model Context Protocol server that lets an AI client read and change an Irish charity’s governance records as the person running it.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/jasperfordesq-ai/charity-governance.git",
    "directory": "mcp"
  },
  "homepage": "https://github.com/jasperfordesq-ai/charity-governance/tree/master/mcp#readme",
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "charity",
    "governance",
    "ireland"
  ],
  "private": true,
  "files": [
    "dist",
    "!dist/tests",
    "manifest.json",
    "README.md"
  ],
  "type": "module",
  "bin": {
    "charitypilot-mcp": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test dist/tests/*.test.js",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@napi-rs/keyring": "1.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
